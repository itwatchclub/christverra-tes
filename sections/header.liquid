{% schema %}
{
  "name": "Header",
  "class": "shopify-section--header",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "default": true,
      "label": "Use sticky header",
      "info": "Header stays at the top of the page as you scroll."
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "200 x 60px .png recommended"
    },
    {
      "type": "image_picker",
      "id": "logo_transparent",
      "label": "Logo Transparent",
      "info": "200 x 60px .png recommended"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 350,
      "step": 5,
      "default": 140,
      "unit": "px",
      "label": "Image width"
    },
    {
      "type": "range",
      "id": "mobile_logo_max_width",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "px",
