    function show(s){
      const currentStep = document.querySelector('#wf .step[style*="display: block"], #wf .step:not([style*="display: none"])');
      const nextStep = document.querySelector('#wf .step[data-step="'+s+'"]');
      
      if (currentStep && currentStep !== nextStep) {
        // Fade out step saat ini
        currentStep.classList.add('fade-out');
        currentStep.classList.remove('fade-in');
        
        // Setelah fade out selesai, hide dan show step baru
        setTimeout(function() {
          document.querySelectorAll('#wf .step').forEach(el=>{
            el.style.display='none';
            el.classList.remove('fade-in', 'fade-out');
          });
          
          if (nextStep) {
            nextStep.style.display='block';
            // Trigger reflow untuk memastikan display:block diterapkan
            nextStep.offsetHeight;
            // Fade in step baru
            nextStep.classList.add('fade-in');
          }
        }, 300);
      } else {
        // Jika tidak ada step yang aktif atau step yang sama, langsung show
        document.querySelectorAll('#wf .step').forEach(el=>{
          el.style.display='none';
          el.classList.remove('fade-in', 'fade-out');
        });
        
        if (nextStep) {
          nextStep.style.display='block';
          nextStep.offsetHeight;
          nextStep.classList.add('fade-in');
        }
      }
  
      // Maksimal step 3
      const maxStep = Math.min(s, 2);
      
      document.querySelectorAll('.w-progress .p-step-wrapper').forEach((el,i)=>{
        const stepEl = el.querySelector('.p-step');
        if (stepEl) {
          stepEl.classList.toggle('active', i+1<=maxStep);
          // Tandai wrapper sebagai active jika langkah sudah dilewati
          el.classList.toggle('active', i+1<maxStep);
        }
      });
      
      // Step address sudah dimatikan, jadi auto-fill country berbasis IP tidak dipakai.
    }
    
    // Function untuk check apakah semua required fields sudah terisi
    function checkStepFields(stepNumber) {
      const currentStep = document.querySelector('#wf .step[data-step="' + stepNumber + '"]');
      if (!currentStep) return false;
      
      const requiredInputs = currentStep.querySelectorAll('input[required], select[required]');
      let allFilled = true;
      
      requiredInputs.forEach(input => {
        // Skip jika input disabled
        if (input.disabled) return;
        
        // Khusus untuk store field (hanya required jika purchase_method = "store")
        if (input.id === 'store_select') {
          const purchaseMethod = document.getElementById('purchase_method')?.value;
          if (purchaseMethod !== 'store') {
            return; // Skip validation jika bukan store
          }
        }
        
        // wf_cc_digits: kosong = pakai default 62, tetap dianggap terisi
        if (input.id === 'wf_cc_digits') {
          return;
        }
        
        // Cek apakah value kosong
        const value = input.value ? input.value.trim() : '';
        if (!value) {
          allFilled = false;
        }
      });
      
      return allFilled;
    }
    
    // Function untuk update button opacity
    function updateButtonOpacity() {
      const nextButtons = document.querySelectorAll('.next');
      const submitButtons = document.querySelectorAll('.submit');
      
      // Update Next buttons
      nextButtons.forEach(btn => {
        const currentStep = btn.closest('.step');
        if (currentStep) {
          const stepNumber = parseInt(currentStep.getAttribute('data-step'));
          const isValid = checkStepFields(stepNumber);
          btn.style.opacity = isValid ? '1' : '0.5';
          btn.style.pointerEvents = isValid ? 'auto' : 'none';
        }
      });
      
      // Update Submit buttons
      submitButtons.forEach(btn => {
        const currentStep = btn.closest('.step');
        if (currentStep) {
          const stepNumber = parseInt(currentStep.getAttribute('data-step'));
          const isValid = checkStepFields(stepNumber);
          btn.style.opacity = isValid ? '1' : '0.5';
          btn.style.pointerEvents = isValid ? 'auto' : 'none';
        }
      });
    }
    
    // Update button opacity saat halaman dimuat
    updateButtonOpacity();
    
    // Bersihkan error dan update button opacity saat user mengetik
    document.querySelectorAll('input[required], select[required]').forEach(input => {
      input.addEventListener('input', function() {
        hideError(this.id);
        updateButtonOpacity();
      });
      input.addEventListener('change', function() {
        hideError(this.id);
        updateButtonOpacity();
      });
    });
    
    document.querySelectorAll('.next').forEach(btn=>{
      btn.onclick=()=>{
        // Validasi form sebelum langkah berikutnya
        const currentStep = document.querySelector('#wf .step[data-step="'+step+'"]');
        if (currentStep) {
          const inputs = currentStep.querySelectorAll('input[required], select[required]');
          let isValid = true;
          
          // Bersihkan semua error dulu
          inputs.forEach(input => {
            hideError(input.id);
          });
          
          inputs.forEach(input => {
            // Skip wf_cc_digits: kosong = pakai default 62 saat submit
            if (input.id === 'wf_cc_digits') return;
            
            // Cek apakah input valid
            if (!input.checkValidity()) {
              isValid = false;
              let errorMessage = 'This field is required';
              
              if (input.type === 'email' && input.value && !input.validity.valid) {
                errorMessage = 'Please enter a valid email address';
              } else if (input.type === 'tel' && input.value && !input.validity.valid) {
                errorMessage = 'Please enter a valid phone number';
              }
              
              showError(input.id, errorMessage);
            }
          });
          
          // Validasi khusus untuk store dropdown (hanya jika purchase_method = "store")
          const purchaseMethod = document.getElementById('purchase_method')?.value;
          const storeSelectInput = document.getElementById('store_select');
          if (storeSelectInput && currentStep.contains(storeSelectInput) && purchaseMethod === 'store') {
            if (!storeSelectInput.value || storeSelectInput.value.trim() === '') {
              isValid = false;
              showError('store_select', 'This field is required');
            }
          }
          
          // Jika valid, lanjut ke langkah berikutnya (maksimal step 2)
          if (isValid) {
            if (step < 2) {
              step++; 
              show(step);
              setTimeout(updateButtonOpacity, 350); // Update opacity setelah step berubah
            } else {
              // Di step 2, submit form
              submitWarrantyForm();
            }
          }
        } else {
          if (step < 2) {
            step++; 
            show(step);
            setTimeout(updateButtonOpacity, 350); // Update opacity setelah step berubah
          } else {
            // Di step 2, submit form
            submitWarrantyForm();
          }
        }
      }
    });
  
    document.querySelectorAll('.prev').forEach(btn=>{
      btn.onclick=()=>{ 
        if (step > 1) {
          step--; 
          show(step);
          setTimeout(updateButtonOpacity, 350); // Update opacity setelah step berubah
        }
      }
    });
    
    // Prevent default form submission
    const form = document.getElementById('wf');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        submitWarrantyForm();
      });
    }
  
    // Dropdown kode telepon kustom
    const phoneCodeInput = document.getElementById('wf_cc_digits');
    const phoneCodeHidden = document.getElementById('phone_code_value');
    const phoneCodeWrapper = document.querySelector('.phone-code-wrapper');
    const phoneCodeToggle = document.querySelector('.phone-code-toggle');
    const phoneCodeDropdown = document.querySelector('.phone-code-dropdown');
    let phoneCodeOptions = document.querySelectorAll('.phone-code-option');
    
    if (phoneCodeInput && phoneCodeWrapper && phoneCodeDropdown && phoneCodeToggle) {
        function getPhoneCodeMetaList() {
          var list = [];
          phoneCodeOptions.forEach(function(opt) {
            var value = opt.getAttribute('data-value') || '';
            var digits = value.replace(/^\+/, '');
            if (digits) list.push({ value: value, digits: digits });
          });
          list.sort(function(a, b) { return b.digits.length - a.digits.length; });
          return list;
        }

        function restorePhoneCodeFromHidden() {
          var fb = (phoneCodeHidden.value || '+62').replace(/^\+/, '');
          phoneCodeInput.value = fb;
        }

        // Pulihkan angka setelah autofill (nama negara, "+62 ...", atau nomor lengkap di field kode)
        function normalizePhoneCodeField() {
          var v = phoneCodeInput.value.trim();
          if (!v) {
            phoneCodeHidden.value = '+62';
            return;
          }
          var meta = getPhoneCodeMetaList();
          var compact = v.replace(/\D/g, '');
          var hasLetters = /[a-zA-Z]/.test(v);
          var noPlus = v.replace(/^\++/, '').trim();

          var j, row, nextCh;
          for (j = 0; j < meta.length; j++) {
            row = meta[j];
            if (noPlus.startsWith(row.digits)) {
              nextCh = noPlus.charAt(row.digits.length);
              if (!nextCh || /\D/.test(nextCh)) {
                phoneCodeInput.value = row.digits;
                phoneCodeHidden.value = row.value;
                return;
              }
            }
          }

          if (hasLetters) {
            var lower = v.toLowerCase();
            var k, opt, label, value, m, inside, parts, a, alias;
            for (k = 0; k < phoneCodeOptions.length; k++) {
              opt = phoneCodeOptions[k];
              label = opt.getAttribute('data-label') || '';
              value = opt.getAttribute('data-value') || '';
              m = label.match(/\(([^)]+)\)/);
              if (!m) continue;
              inside = m[1];
              parts = inside.split('/');
              for (a = 0; a < parts.length; a++) {
                alias = parts[a].trim().toLowerCase();
                if (alias.length < 3) continue;
                if (lower.indexOf(alias) !== -1) {
                  phoneCodeInput.value = value.replace(/^\+/, '');
                  phoneCodeHidden.value = value;
                  return;
                }
              }
            }
          }

          if (!hasLetters && compact.length > 0) {
            if (compact.length <= 4) {
              phoneCodeInput.value = compact;
              phoneCodeHidden.value = '+' + compact;
              return;
            }
            var i, mrow;
            for (i = 0; i < meta.length; i++) {
              mrow = meta[i];
              if (compact.startsWith(mrow.digits) && compact.length > mrow.digits.length) {
                phoneCodeInput.value = mrow.digits;
                phoneCodeHidden.value = mrow.value;
                var rest = compact.slice(mrow.digits.length);
                var phoneEl = document.getElementById('phone');
                if (phoneEl && !phoneEl.value.trim()) {
                  phoneEl.value = rest;
                }
                return;
              }
            }
          }

          if (compact.length >= 1 && compact.length <= 4) {
            var n, crow;
            for (n = 0; n < meta.length; n++) {
              crow = meta[n];
              if (compact === crow.digits) {
                phoneCodeInput.value = crow.digits;
                phoneCodeHidden.value = crow.value;
                return;
              }
            }
          }

          restorePhoneCodeFromHidden();
        }

        function unlockPhoneCodeInput() {
          phoneCodeInput.removeAttribute('readonly');
        }

        phoneCodeWrapper.addEventListener('pointerdown', unlockPhoneCodeInput, { capture: true });

        // Fungsi filter - bisa mencari berdasarkan angka atau nama negara
        function filterOptions(searchText) {
          let hasVisible = false;
          phoneCodeOptions.forEach(function(option) {
            const text = option.textContent.toLowerCase();
            const search = searchText.toLowerCase().trim();
            
            // Cek apakah pencarian cocok dengan:
            // 1. Kode negara (angka dengan/tanpa +)
            // 2. Nama negara (dalam kurung)
            // 3. Teks lengkap (kode + nama negara)
            
            const countryCode = text.match(/\+?\d+/)?.[0] || '';
            const countryName = text.match(/\(([^)]+)\)/)?.[1] || '';
            const fullText = text;
            
            const searchWithoutPlus = search.replace('+', '');
            const countryCodeWithoutPlus = countryCode.replace('+', '');
            
            // Cocok jika:
            // - Pencarian kosong (tampilkan semua)
            // - Pencarian cocok dengan kode negara (dengan/tanpa +)
            // - Pencarian cocok dengan nama negara
            // - Pencarian cocok dengan teks lengkap
            if (search === '' || 
                countryCodeWithoutPlus.includes(searchWithoutPlus) ||
                countryName.includes(search) ||
                fullText.includes(search)) {
              option.style.display = 'block';
              hasVisible = true;
            } else {
              option.style.display = 'none';
            }
          });
          return hasVisible;
        }
        
        // Klik tombol toggle - fokus ke input
        phoneCodeToggle.addEventListener('click', function(e) {
          e.stopPropagation();
          e.preventDefault();
          
          // Jika dropdown sudah aktif, blur dan tutup
          if (phoneCodeWrapper.classList.contains('active')) {
            phoneCodeInput.blur();
            phoneCodeWrapper.classList.remove('active');
          } else {
            // Fokus ke input dan tampilkan dropdown
            phoneCodeInput.focus();
            phoneCodeWrapper.classList.add('active');
            filterOptions(phoneCodeInput.value);
          }
        });
        
        // Tampilkan dropdown saat input focus
        phoneCodeInput.addEventListener('focus', function(e) {
          unlockPhoneCodeInput();
          phoneCodeWrapper.classList.add('active');
          filterOptions(phoneCodeInput.value);
          setTimeout(normalizePhoneCodeField, 50);
          setTimeout(normalizePhoneCodeField, 300);
        });
        
        phoneCodeInput.addEventListener('click', function(e) {
          e.stopPropagation();
          unlockPhoneCodeInput();
          phoneCodeWrapper.classList.add('active');
          filterOptions(phoneCodeInput.value);
        });

        phoneCodeInput.addEventListener('change', function() {
          normalizePhoneCodeField();
          filterOptions(phoneCodeInput.value);
        });
        
        // Filter saat user mengetik
        phoneCodeInput.addEventListener('input', function(e) {
          if (!phoneCodeInput.value.trim()) {
            phoneCodeHidden.value = '+62';
          } else {
            normalizePhoneCodeField();
          }
          phoneCodeWrapper.classList.add('active');
          filterOptions(phoneCodeInput.value);
        });
        
        // Tutup dropdown saat klik di luar
        document.addEventListener('click', function(e) {
          if (!phoneCodeWrapper.contains(e.target)) {
            phoneCodeWrapper.classList.remove('active');
          }
        });
        
        // Tangani klik opsi
        phoneCodeOptions.forEach(function(option) {
          option.addEventListener('click', function(e) {
            e.stopPropagation();
            const value = this.getAttribute('data-value');
            const label = this.getAttribute('data-label');
            
            // Hanya simpan angka tanpa + di input (contoh: "62" bukan "+62")
            const numberOnly = value.replace('+', '');
            phoneCodeInput.value = numberOnly;
            phoneCodeHidden.value = value; // Hidden field tetap dengan +
            phoneCodeWrapper.classList.remove('active');
          });
        });
        
        // Set nilai default jika kosong saat form submit
        const form = document.getElementById('wf');
        if (form) {
          form.addEventListener('submit', function(e) {
            normalizePhoneCodeField();
            // Jika input kosong, set default +62
            if (!phoneCodeInput.value || phoneCodeInput.value.trim() === '') {
              phoneCodeInput.value = '62';
              phoneCodeHidden.value = '+62';
            } else {
              // Jika ada nilai, pastikan field tersembunyi juga diperbarui dengan +
              const inputValue = phoneCodeInput.value.trim();
              if (!inputValue.startsWith('+')) {
                phoneCodeHidden.value = '+' + inputValue;
              } else {
                phoneCodeHidden.value = inputValue;
              }
            }
          });
        }

        setTimeout(normalizePhoneCodeField, 800);
        setTimeout(normalizePhoneCodeField, 2000);
    }
  
    // Fungsi dropzone
    {% comment %} const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('invoice');
    const dropzoneText = dropzone.querySelector('.dropzone-text');
    const dropzoneFilename = dropzone.querySelector('.dropzone-filename'); {% endcomment %}
  
    {% comment %} if (dropzone && fileInput) {
      // Klik untuk mengunggah
      dropzone.addEventListener('click', () => {
        fileInput.click();
      });
  
      // File dipilih
      fileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) {
          // Validasi ukuran file maksimal 2MB
          const maxSize = 2 * 1024 * 1024; // 2MB
          if (file.size > maxSize) {
            showPopup('simple', 'error-file-too-large', null, [
              {
                text: getPopupButtonText('error-file-too-large', 'ok'),
                onclick: function() {
                  hidePopup();
                  // Reset file input
                  fileInput.value = '';
                  dropzoneText.style.display = 'block';
                  dropzoneFilename.style.display = 'none';
                  dropzone.classList.remove('has-file');
                }
              }
            ]);
            return;
          }
          
          dropzoneText.style.display = 'none';
          dropzoneFilename.textContent = file.name;
          dropzoneFilename.style.display = 'block';
          dropzone.classList.add('has-file');
        }
      });
  
      // Seret dan lepas
      dropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropzone.classList.add('dragover');
      });
  
      dropzone.addEventListener('dragleave', () => {
        dropzone.classList.remove('dragover');
      });
  
      dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropzone.classList.remove('dragover');
        
        const files = e.dataTransfer.files;
        if (files.length > 0) {
          const file = files[0];
          // Cek apakah file adalah gambar atau PDF
          if (file.type.startsWith('image/') || file.type === 'application/pdf') {
            // max limit 2MB
            const maxSize = 2 * 1024 * 1024; // 2MB
            if (file.size > maxSize) {
                showPopup('simple', 'error-file-too-large', null, [
                  {
                    text: getPopupButtonText('error-file-too-large', 'ok'),
                    onclick: function() {
                      hidePopup();
                      dropzone.classList.remove('dragover');
                    }
                  }
                ]);
                return;
            }
            fileInput.files = files;
            dropzoneText.style.display = 'none';
            dropzoneFilename.textContent = file.name;
            dropzoneFilename.style.display = 'block';
            dropzone.classList.add('has-file');
          } else {
            alert('Please upload an image or PDF file');
          }
        }
      });
    } {% endcomment %}
  
    // Input nomor telepon - hanya angka
    const phoneNumberInput = document.getElementById('phone');
    const phoneInputWrapper = document.querySelector('.phone-input-wrapper');
    
    function updatePhoneWrapperBorder() {
      if (phoneInputWrapper) {
        const hasCode = phoneCodeInput && phoneCodeInput.value.trim() !== '';
        const hasNumber = phoneNumberInput && phoneNumberInput.value.trim() !== '';
        
        if (hasCode || hasNumber) {
          phoneInputWrapper.classList.add('has-value');
        } else {
          phoneInputWrapper.classList.remove('has-value');
        }
      }
    }
    
    if (phoneNumberInput) {
      phoneNumberInput.addEventListener('input', function(e) {
        // Hanya izinkan angka
        this.value = this.value.replace(/[^0-9]/g, '');
        updatePhoneWrapperBorder();
      });
      
      phoneNumberInput.addEventListener('keypress', function(e) {
        // Cegah karakter non-numerik
        const char = String.fromCharCode(e.which);
        if (!/[0-9]/.test(char)) {
          e.preventDefault();
        }
      });
      
      // Cegah paste non-numerik
      phoneNumberInput.addEventListener('paste', function(e) {
        e.preventDefault();
        const paste = (e.clipboardData || window.clipboardData).getData('text');
        const numbersOnly = paste.replace(/[^0-9]/g, '');
        this.value = numbersOnly;
        updatePhoneWrapperBorder();
      });
      
      phoneNumberInput.addEventListener('blur', function() {
        updatePhoneWrapperBorder();
      });
    }
    
    
    // Perbarui border saat kode telepon berubah
    if (phoneCodeInput) {
      phoneCodeInput.addEventListener('input', updatePhoneWrapperBorder);
      phoneCodeInput.addEventListener('blur', updatePhoneWrapperBorder);
    }

    // Expired date diisi otomatis = purchase date + 1 tahun
    function updateExpiredDate() {
      const purchaseDateInput = document.getElementById('purchase_date');
      const expiredDateInput = document.getElementById('expired_date');
      if (!purchaseDateInput || !expiredDateInput) return;

      const purchaseDate = purchaseDateInput.value;
      if (!purchaseDate) {
        expiredDateInput.value = '';
        return;
      }

      const date = new Date(purchaseDate + 'T00:00:00');
      if (isNaN(date.getTime())) {
        expiredDateInput.value = '';
        return;
      }

      date.setFullYear(date.getFullYear() + 1);
      const yyyy = date.getFullYear();
      const mm = String(date.getMonth() + 1).padStart(2, '0');
      const dd = String(date.getDate()).padStart(2, '0');
      expiredDateInput.value = `${yyyy}-${mm}-${dd}`;
    }

    const purchaseDateInput = document.getElementById('purchase_date');
    if (purchaseDateInput) {
      purchaseDateInput.addEventListener('change', updateExpiredDate);
      purchaseDateInput.addEventListener('input', updateExpiredDate);
    }

    // Store diisi dari distributor (readonly); tetap tergantung purchase method.
    function updateStoreFieldState() {
      const purchaseMethodSelect = document.getElementById('purchase_method');
      const storeSelectInput = document.getElementById('store_select');
      if (!purchaseMethodSelect || !storeSelectInput) return;

      const purchaseMethod = purchaseMethodSelect.value;
      if (purchaseMethod === 'Online') {
        storeSelectInput.value = 'Online';
        storeSelectInput.disabled = true;
        storeSelectInput.removeAttribute('required');
        hideError('store_select');
      } else if (purchaseMethod === 'store') {
        storeSelectInput.disabled = false;
        storeSelectInput.setAttribute('required', 'required');
        fillStoreFromDistributor();
      } else {
        storeSelectInput.value = '';
        storeSelectInput.disabled = true;
        storeSelectInput.removeAttribute('required');
        hideError('store_select');
      }
    }
    
    // Handler untuk Purchase Method - disable/enable store field
    const purchaseMethodSelect = document.getElementById('purchase_method');
    if (purchaseMethodSelect) {
      // Update state saat purchase method berubah
      purchaseMethodSelect.addEventListener('change', function() {
        updateStoreFieldState();
        updateButtonOpacity();
      });
      
      // Update state saat page load (untuk handle default state)
      updateStoreFieldState();
    }

    // Saat no_id_distributor dipilih, isi store_select dengan store_name
    const distributorSelect = document.getElementById('no_id_distributor');
    if (distributorSelect) {
      distributorSelect.addEventListener('change', function() {
        fillStoreFromDistributor();
        hideError('no_id_distributor');
        hideError('store_select');
        updateButtonOpacity();
      });
    }
  
    show(step);
    
    // Set fade-in untuk step pertama saat page load
    const firstStep = document.querySelector('#wf .step[data-step="1"]');
    if (firstStep) {
      firstStep.style.display = 'block';
      firstStep.offsetHeight;
      firstStep.classList.add('fade-in');
    }
    
    // Update button opacity setelah step pertama dimuat
    setTimeout(updateButtonOpacity, 100);
  });
  </script>
  