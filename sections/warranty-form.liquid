    <div data-type="error-save-failed-message">Terjadi kesalahan saat menyimpan data. Silakan coba lagi.</div>
    
    <div data-type="error-file-too-large-title">File Terlalu Besar</div>
    <div data-type="error-file-too-large-message">File size must be less than 2MB. Foto gagal diupload. Please choose a smaller file and try again.</div>
    <div data-type="error-file-too-large-btn-ok">OK</div>
  </div>
  
  {% schema %}
  {
    "name": "Warranty Form",
    "settings": [
      {
        "type": "header",
        "content": "Progress Icons"
      },
      {
        "type": "image_picker",
        "id": "icon_step1",
        "label": "Icon — Step 1 (Personal Info)"
      },
      {
        "type": "image_picker",
        "id": "icon_step2",
        "label": "Icon — Step 2 (Address)"
      } 
    ]
  }
  {% endschema %}
  </section>
  
  
  <script>
  // Integrasi API CountriesNow
  const COUNTRIESNOW_BASE_URL = 'https://countriesnow.space/api/v0.1/countries';
  
  // API Configuration untuk warranty endpoint
  const WARRANTY_API_BASE_URL = 'https://shopify-custom-apps-general.devbdd.com/api/dashboard/insert-meta-object';
  const DISTRIBUTOR_API_BASE_URL = 'https://shopify-custom-apps-general.devbdd.com/api/dashboard/distributors';
  
  let countries = [];
  let provinces = [];
  let cities = [];
  let distributors = [];
  
  // Function helper untuk get country code dari country name (global scope)
  function getCountryCode(countryName) {
    if (!countryName || !countries || countries.length === 0) return '';
    const country = countries.find(c => c.name === countryName);
    return country ? (country.iso2 || '') : '';
  }
  
  // Load countries
  async function loadCountries() {
    const countryInput = document.getElementById('country');
    const countryPurchaseInput = document.getElementById('country_purchase');
    if (!countryInput && !countryPurchaseInput) return;
    
    try {
      const response = await fetch(`${COUNTRIESNOW_BASE_URL}`);
      
      if (response.ok) {
        const data = await response.json();
        if (data.error === false && data.data) {
          countries = data.data.map(item => ({
            name: item.country || item.name,
            iso2: item.iso2 || '',
            iso3: item.iso3 || ''
          }));
          
          // Urutkan negara berdasarkan nama
          countries.sort((a, b) => a.name.localeCompare(b.name));
        }
      }
    } catch (error) {
      console.error('Error loading countries:', error);
    }
  }

  // GET distributors dari DISTRIBUTOR_API_BASE_URL, isi no_id_distributor
  async function getDistributor() {
    const distributorSelect = document.getElementById('no_id_distributor');
    if (!distributorSelect) return;

    try {
      const response = await fetch(DISTRIBUTOR_API_BASE_URL, { method: 'GET' });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
      }

      const data = await response.json();
      distributors = Array.isArray(data) ? data : (data.data || []);

      distributorSelect.innerHTML = '<option value="" selected hidden>No ID Distributor</option>';

      distributors.forEach(item => {
        const option = document.createElement('option');
        option.value = item.distributor_id || '';
        option.textContent = item.distributor_id || '';
        option.dataset.storeName = item.store_name || '';
        distributorSelect.appendChild(option);
      });
    } catch (error) {
      console.error('Error loading distributors:', error);
    }
  }

  // Isi store_select dari store_name berdasarkan distributor yang dipilih
  function fillStoreFromDistributor() {
    const distributorSelect = document.getElementById('no_id_distributor');
    const storeSelectInput = document.getElementById('store_select');
    if (!distributorSelect || !storeSelectInput) return;

    const purchaseMethod = document.getElementById('purchase_method')?.value;
    if (purchaseMethod === 'Online') return;

    const selectedOption = distributorSelect.options[distributorSelect.selectedIndex];
    const storeName = selectedOption?.dataset?.storeName
      || distributors.find(d => d.distributor_id === distributorSelect.value)?.store_name
      || '';

    storeSelectInput.value = storeName;
  }
  
  document.addEventListener('DOMContentLoaded', function(){
    let step = 1;
    
    // Function untuk reset form ke kondisi awal
    function resetForm() {
      const form = document.getElementById('wf');
      if (!form) return;
      
      // Reset semua input fields
      const inputs = form.querySelectorAll('input[type="text"], input[type="email"], input[type="tel"], input[type="date"]');
      inputs.forEach(input => {
        input.value = '';
        input.classList.remove('error');
        // Reset disabled state untuk country/state/city
        if (input.id === 'state' || input.id === 'city') {
          input.disabled = true;
        }
      });
      
      // Reset select dropdowns
      const selects = form.querySelectorAll('select');
      selects.forEach(select => {
        select.value = '';
        select.classList.remove('error');
      });
      
      // Reset store field ke disabled state (karena purchase method juga direset)
      const storeSelectInput = document.getElementById('store_select');
      if (storeSelectInput) {
        storeSelectInput.value = '';
        storeSelectInput.disabled = true;
        storeSelectInput.removeAttribute('required');
      }
      
      // Reset file input
      {% comment %} const fileInput = document.getElementById('invoice');
      if (fileInput) {
        fileInput.value = '';
        const dropzone = document.getElementById('dropzone');
        const dropzoneText = dropzone?.querySelector('.dropzone-text');
        const dropzoneFilename = dropzone?.querySelector('.dropzone-filename');
        if (dropzone) {
          dropzone.classList.remove('has-file', 'dragover');
        }
        if (dropzoneText) dropzoneText.style.display = 'block';
        if (dropzoneFilename) dropzoneFilename.style.display = 'none';
      } {% endcomment %}
      
      // Reset hidden fields
      const hiddenInputs = form.querySelectorAll('input[type="hidden"]');
      hiddenInputs.forEach(input => {
        if (input.id === 'phone_code_value') {
          input.value = '+62'; // Default phone code
        } else {
          input.value = '';
        }
      });
      
      // Reset phone code: field dikosongkan agar yang tampil hanya placeholder "62"
      // (nilai default 62 dipakai saat submit jika kosong — lihat listener submit ~baris 2339)
      const phoneCodeInput = document.getElementById('wf_cc_digits');
      if (phoneCodeInput) {
        phoneCodeInput.value = '';
        phoneCodeInput.setAttribute('readonly', 'readonly');
      }
      
      // Clear semua error messages
      const errorMessages = form.querySelectorAll('.error-message');
      errorMessages.forEach(error => {
        error.textContent = '';
        error.style.display = 'none';
      });
      
      // Reset phone wrapper border
      const phoneWrapper = document.querySelector('.phone-input-wrapper');
      if (phoneWrapper) {
        phoneWrapper.classList.remove('error', 'has-value');
      }
      
      // Reset country purchase dropdown
      const countryPurchaseWrapper = document.querySelector('.country-purchase-wrapper');
      const countryPurchaseDropdown = document.getElementById('country_purchase_dropdown');
      const countryPurchaseArrow = document.querySelector('.country-purchase-arrow');
      if (countryPurchaseWrapper) {
        countryPurchaseWrapper.classList.remove('active');
      }
      if (countryPurchaseDropdown) {
        countryPurchaseDropdown.style.display = 'none';
      }
      if (countryPurchaseArrow) {
        countryPurchaseArrow.style.transform = 'rotate(0deg)';
      }
      
      // Reset step ke 1
      step = 1;
      show(step);
      
      // Clear localStorage jika ada data lama
      localStorage.removeItem('warrantyFormData');
      
      // Reset arrays untuk country/state/city
      provinces = [];
