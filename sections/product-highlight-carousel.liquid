{{ 'product-highlight-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-highlight-carousel.js' | asset_url }}" defer="defer"></script>

<product-highlight-carousel id="section-{{ section.id }}" data-section-id="{{ section.id }}">
    <div class="page-width small-container product-highlight-container">
      <div class="grid grid--gapless grid--1-col grid--2-col-tablet">
        <div class="grid__item empty-element" style="opacity: 0;">left</div>
        <div class="grid__item header-product-carousel">
          <div class="product-carousel-collection ">
            <span>{{ section.settings.title | upcase }}</span>
          </div>
          {%- if section.blocks.size > 1 -%}
            <div class="custom-owl-nav ">
              <button type="button" class="product-highlight-carousel__nav product-highlight-carousel__nav--prev" aria-label="{{ 'accessibility.previous_slide' | t }}">
                <svg class="nav-carousel prev" width="18" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M7.6663 15L0.999634 8M0.999634 8L7.6663 1M0.999634 8L16.9996 8" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <span class="current-slide">1</span> / <span class="total-slides">{{ section.blocks.size }}</span>
              <button type="button" class="product-highlight-carousel__nav product-highlight-carousel__nav--next" aria-label="{{ 'accessibility.next_slide' | t }}">
                <svg class="nav-carousel next" width="18" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10.3336 1L17.0002 8M17.0002 8L10.3336 15M17.0002 8L1.00024 8" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          {%- endif -%}
        </div>
      </div>
      <div class="product-highlight-carousel Carousel Carousel--fadeIn">
        {% for block in section.blocks %}
          {% assign product = all_products[block.settings.product] %}
          <div class="product-carousel-item Carousel__Cell{% if forloop.first %} is-selected{% endif %}"
               data-slide-index="{{ forloop.index0 }}"
               {% if forloop.first %}style="visibility: visible"{% endif %}
               {{ block.shopify_attributes }}>
          <div class="grid grid--gapless grid--1-col grid--2-col-tablet">
            <div class="grid__item section-product-image">
              {{ product.featured_image | img_url: 'master' | img_tag: '' }}
            </div>
            <div class="grid__item">
              <div class="product-carousel-info pt-20 pb-20 ">
                <div class="product-type">
                  <span>{{ product.type }}</span>
                </div>
                <div class="product-title">
                  <span>{{ product.title }}</span>
                </div>
                <div class="product-price">
                  <div class="product-price-left">
                    {%- if product.compare_at_price > product.price -%}
                      <span class="product-final">{{ product.price | money_without_trailing_zeros }}</span>
                      <span class="product-compare">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
                    {%- else -%}
                      <span class="product-normal">{{ product.price | money_without_trailing_zeros }}</span>
                    {%- endif -%}
                  </div>
                  {% if product.compare_at_price > product.price %}
                    <div class="product-price-right">
                      {% capture discount %}
                        {{ product.compare_at_price_max | minus:product.price | times:100 | divided_by:product.compare_at_price_max }}% 
                      {% endcapture %}
                      <span class="ProductItem__Label Heading Text--subdued">
                        {% comment %}{{ 'product.labels.on_sale' | t }}{% endcomment %}
                        {{ discount }}
                      </span>
                    </div>
                  {% endif %}
                </div>
                <div class="product-description">
                  <div class="Rte">
                    {% assign product_desc = product.description | strip_html %}
                    {% assign short_desc = product_desc | split: 'About' %}
                    {{ short_desc[0] | truncate: 250 }}
                  </div>
                </div>
              </div>
              <div class="product-link ">
                <a href="{{ product.url | within: collection }}" class="product-link-button">
                  <span>{{ 'buy now' | upcase }}</span>
                  {% render 'icon' with 'figma-arrow-top-right' %}
                </a>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</product-highlight-carousel>
{% schema %}
{
  "name": "Product highlight",
  "class": "shopify-product-highlight",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Product",
      "name": "Product highlight",
      "settings": {}
    }
  ]
}
{% endschema %}