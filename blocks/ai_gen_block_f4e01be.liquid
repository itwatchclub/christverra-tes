{% doc %}
  @prompt
    buatkan section dengan nama Product highlight dengan input title sectionnya
    lalu didalam nya ada blocks inputannya product
    tampilannya 2 column: dikiri image product dikanan Title section, product type,title produk, harga, short description (kasih max karakter 200 kalo lebih kasih ...), button buy now kalo di klik redirect ke product detail page nya
    
    untuk tampilann block nya buat carousel utk masing block
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-highlight-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .ai-product-highlight-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .ai-product-highlight-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-highlight-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-highlight-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-highlight-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-highlight-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-product-highlight-section-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    color: {{ block.settings.section_title_color }};
    margin: 0;
    font-weight: 700;
  }

  .ai-product-highlight-product-type-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_type_size }}px;
    color: {{ block.settings.product_type_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
  }

  .ai-product-highlight-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-product-highlight-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 700;
  }

  .ai-product-highlight-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-product-highlight-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 15px 40px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    text-align: center;
    border: none;
    cursor: pointer;
  }

  .ai-product-highlight-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-product-highlight-carousel-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 30px;
  }

  .ai-product-highlight-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-product-highlight-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-product-highlight-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-size: 16px;
  }

  @media screen and (max-width: 768px) {
    .ai-product-highlight-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 30px 15px;
    }

    .ai-product-highlight-section-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.section_title_size }}px * 0.8);
    }

    .ai-product-highlight-product-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.product_title_size }}px * 0.85);
    }
  }
{% endstyle %}

<product-highlight-carousel-{{ ai_gen_id }} class="ai-product-highlight-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.products.size > 0 %}
    <div class="ai-product-highlight-carousel-wrapper-{{ ai_gen_id }}">
      {% for product in block.settings.products %}
        <div class="ai-product-highlight-slide-{{ ai_gen_id }}" data-slide-index="{{ forloop.index0 }}" style="display: {% if forloop.first %}block{% else %}none{% endif %};">
          <div class="ai-product-highlight-container-{{ ai_gen_id }}">
            <div class="ai-product-highlight-image-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% else %}
                <div class="ai-product-highlight-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-product-highlight-content-{{ ai_gen_id }}">
              {% if block.settings.section_title != blank %}
                <h2 class="ai-product-highlight-section-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
              {% endif %}

              {% if product.type != blank %}
                <p class="ai-product-highlight-product-type-{{ ai_gen_id }}">{{ product.type }}</p>
              {% endif %}

              <h3 class="ai-product-highlight-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>

              <div class="ai-product-highlight-price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>

              {% if product.description != blank %}
                {% assign description_text = product.description | strip_html | truncate: 200 %}
                <p class="ai-product-highlight-description-{{ ai_gen_id }}">{{ description_text }}</p>
              {% endif %}

              <a href="{{ product.url }}" class="ai-product-highlight-button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if block.settings.products.size > 1 %}
      <div class="ai-product-highlight-carousel-dots-{{ ai_gen_id }}">
        {% for product in block.settings.products %}
          <button
            class="ai-product-highlight-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-dot-index="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  {% else %}
    <div class="ai-product-highlight-empty-state-{{ ai_gen_id }}">
      Pilih produk untuk ditampilkan di Product Highlight
    </div>
  {% endif %}
</product-highlight-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductHighlightCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-product-highlight-slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-product-highlight-dot-{{ ai_gen_id }}');
        
        if (this.slides.length <= 1) return;

        this.setupEventListeners();
        this.startAutoplay();
      }

      setupEventListeners() {
        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const index = parseInt(e.target.dataset.dotIndex);
            this.goToSlide(index);
            this.resetAutoplay();
          });
        });
      }

      goToSlide(index) {
        this.slides[this.currentSlide].style.display = 'none';
        this.dots[this.currentSlide].classList.remove('active');

        this.currentSlide = index;

        this.slides[this.currentSlide].style.display = 'block';
        this.dots[this.currentSlide].classList.add('active');
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        this.goToSlide(nextIndex);
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, 5000);
      }

      resetAutoplay() {
        clearInterval(this.autoplayInterval);
        this.startAutoplay();
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('product-highlight-carousel-{{ ai_gen_id }}', ProductHighlightCarousel{{ ai_gen_id }});
  })();
</script>

