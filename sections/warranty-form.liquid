<section class="warranty-form-wrapper">

    <div class="warranty-form-container">

        <div class="warranty-form-box">
    
          <!-- progress -->
          <div class="w-progress">
            <div class="p-step-wrapper">
              <div class="p-step active">
                {% if section.settings.icon_step1 %}
                  <div class="p-step-icon">
                    <img src="{{ section.settings.icon_step1 | image_url: width: 48 }}" alt="Step 1 icon" width="32" height="32">
                  </div>
                {% else %}
                  <span class="p-step-label">STEP 1</span>
                {% endif %}
              </div>
              <div class="p-step-connector"></div>
            </div>

            <div class="p-step-wrapper">
              <div class="p-step">
                {% if section.settings.icon_step2 %}
                  <div class="p-step-icon">
                    <img src="{{ section.settings.icon_step2 | image_url: width: 48 }}" alt="Step 2 icon" width="32" height="32">
                  </div>
                {% else %}
                  <span class="p-step-label">STEP 2</span>
                {% endif %}
              </div>
              <div class="p-step-connector"></div>
            </div>

            {% comment %} <div class="p-step-wrapper">
              <div class="p-step">
                {% if section.settings.icon_step3 %}
                  <div class="p-step-icon">
                    <img src="{{ section.settings.icon_step3 | image_url: width: 48 }}" alt="Step 3 icon" width="32" height="32">
                  </div>
                {% else %}
                  <span class="p-step-label">STEP 3</span>
                {% endif %}
              </div>
              <div class="p-step-connector"></div>
            </div> {% endcomment %}

          </div>          
    
          <form id="wf" enctype="multipart/form-data">
    
            <!-- STEP 1 – PERSONAL INFO -->
            <div class="step" data-step="1">
    
              <label for="first_name">First Name</label>
              <input id="first_name" name="first_name" placeholder="First Name" required>
              <span class="error-message" id="first_name_error"></span>
              
              <label for="last_name">Last Name</label>
              <input id="last_name" name="last_name" placeholder="Last Name" required>
              <span class="error-message" id="last_name_error"></span>
              
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="Email" required>
              <span class="error-message" id="email_error"></span>
              
              <label for="phone">Contact</label>
              <div class="phone-input-wrapper"> 
                <div class="phone-code-wrapper">
                  <span class="phone-code-prefix">+</span>
                  <input type="text" id="wf_cc_digits" name="wf_cc_digits" class="phone-code" placeholder="62" autocomplete="off" readonly inputmode="numeric">
                  <input type="hidden" id="phone_code_value" name="wf_cc_v" value="+62">
                  <button type="button" class="phone-code-toggle" aria-label="Toggle country code dropdown">
                    <svg class="phone-code-arrow" width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M1 1L6 6L11 1" stroke="#454545" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <div class="phone-code-dropdown">
                    <div class="phone-code-option" data-value="+62" data-label="+62 (Indonesia)">+62 (Indonesia)</div>
                    <div class="phone-code-option" data-value="+1" data-label="+1 (United States/Canada)">+1 (United States/Canada)</div>
                    <div class="phone-code-option" data-value="+44" data-label="+44 (United Kingdom)">+44 (United Kingdom)</div>
                    <div class="phone-code-option" data-value="+60" data-label="+60 (Malaysia)">+60 (Malaysia)</div>
                    <div class="phone-code-option" data-value="+65" data-label="+65 (Singapore)">+65 (Singapore)</div>
                    <div class="phone-code-option" data-value="+66" data-label="+66 (Thailand)">+66 (Thailand)</div>
                    <div class="phone-code-option" data-value="+84" data-label="+84 (Vietnam)">+84 (Vietnam)</div>
                    <div class="phone-code-option" data-value="+86" data-label="+86 (China)">+86 (China)</div>
                    <div class="phone-code-option" data-value="+81" data-label="+81 (Japan)">+81 (Japan)</div>
                    <div class="phone-code-option" data-value="+82" data-label="+82 (South Korea)">+82 (South Korea)</div>
                    <div class="phone-code-option" data-value="+61" data-label="+61 (Australia)">+61 (Australia)</div>
                    <div class="phone-code-option" data-value="+64" data-label="+64 (New Zealand)">+64 (New Zealand)</div>
                    <div class="phone-code-option" data-value="+91" data-label="+91 (India)">+91 (India)</div>
                    <div class="phone-code-option" data-value="+971" data-label="+971 (United Arab Emirates)">+971 (United Arab Emirates)</div>
                    <div class="phone-code-option" data-value="+966" data-label="+966 (Saudi Arabia)">+966 (Saudi Arabia)</div>
                    <div class="phone-code-option" data-value="+49" data-label="+49 (Germany)">+49 (Germany)</div>
                    <div class="phone-code-option" data-value="+33" data-label="+33 (France)">+33 (France)</div>
                    <div class="phone-code-option" data-value="+39" data-label="+39 (Italy)">+39 (Italy)</div>
                    <div class="phone-code-option" data-value="+34" data-label="+34 (Spain)">+34 (Spain)</div>
                    <div class="phone-code-option" data-value="+31" data-label="+31 (Netherlands)">+31 (Netherlands)</div>
                    <div class="phone-code-option" data-value="+32" data-label="+32 (Belgium)">+32 (Belgium)</div>
                    <div class="phone-code-option" data-value="+41" data-label="+41 (Switzerland)">+41 (Switzerland)</div>
                    <div class="phone-code-option" data-value="+46" data-label="+46 (Sweden)">+46 (Sweden)</div>
                    <div class="phone-code-option" data-value="+47" data-label="+47 (Norway)">+47 (Norway)</div>
                    <div class="phone-code-option" data-value="+45" data-label="+45 (Denmark)">+45 (Denmark)</div>
                    <div class="phone-code-option" data-value="+351" data-label="+351 (Portugal)">+351 (Portugal)</div>
                    <div class="phone-code-option" data-value="+353" data-label="+353 (Ireland)">+353 (Ireland)</div>
                    <div class="phone-code-option" data-value="+358" data-label="+358 (Finland)">+358 (Finland)</div>
                    <div class="phone-code-option" data-value="+48" data-label="+48 (Poland)">+48 (Poland)</div>
                    <div class="phone-code-option" data-value="+420" data-label="+420 (Czech Republic)">+420 (Czech Republic)</div>
                    <div class="phone-code-option" data-value="+36" data-label="+36 (Hungary)">+36 (Hungary)</div>
                    <div class="phone-code-option" data-value="+7" data-label="+7 (Russia)">+7 (Russia)</div>
                    <div class="phone-code-option" data-value="+52" data-label="+52 (Mexico)">+52 (Mexico)</div>
                    <div class="phone-code-option" data-value="+55" data-label="+55 (Brazil)">+55 (Brazil)</div>
                    <div class="phone-code-option" data-value="+54" data-label="+54 (Argentina)">+54 (Argentina)</div>
                    <div class="phone-code-option" data-value="+27" data-label="+27 (South Africa)">+27 (South Africa)</div>
                  </div>
                </div>
                <div class="phone-number-divider"></div>
                <input id="phone" name="phone_number" type="tel" placeholder="8123456789" class="phone-number" pattern="[0-9]*" inputmode="numeric" autocomplete="off" required>
              </div>
              <span class="error-message" id="phone_error"></span>
    
              <button type="button" class="next">Next</button>
            </div>
    
            <!-- STEP 2 – ADDRESS -->
            {% comment %} <div class="step" data-step="2" style="display:none;">
    
              <div class="country-state-wrapper">
                <div class="country-state-item">
                  <label for="country">Country</label>
                  <div class="country-search-wrapper">
                    <input type="text" id="country" name="country" placeholder="Search country..." required>
                    <input type="hidden" id="country_value" name="country_value">
                    <button type="button" class="country-toggle" id="country_toggle">
                      <svg class="country-arrow" width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 1L6 6L11 1" stroke="#454545" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <div class="country-dropdown" id="country_dropdown"></div>
                  </div>
                  <span class="error-message" id="country_error"></span>
                </div>
                
                <div class="country-state-item">
                  <label for="state">State / Province</label>
                  <div class="country-search-wrapper state-search-wrapper">
                    <input type="text" id="state" name="state" placeholder="Search state / province..." required disabled>
                    <input type="hidden" id="state_value" name="state_value">
                    <button type="button" class="country-toggle state-toggle" id="state_toggle">
                      <svg class="country-arrow state-arrow" width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 1L6 6L11 1" stroke="#454545" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <div class="country-dropdown state-dropdown" id="state_dropdown"></div>
                  </div>
                  <span class="error-message" id="state_error"></span>
                </div>
              </div>
              
              <label for="city">City</label>
              <div class="country-search-wrapper city-search-wrapper">
                <input type="text" id="city" name="city" placeholder="Search city..." required disabled>
                <input type="hidden" id="city_value" name="city_value">
                <button type="button" class="country-toggle city-toggle" id="city_toggle">
                  <svg class="country-arrow city-arrow" width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1L6 6L11 1" stroke="#454545" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <div class="country-dropdown city-dropdown" id="city_dropdown"></div>
              </div>
              <span class="error-message" id="city_error"></span>
              
              <label for="street">Street</label>
              <input id="street" name="street" placeholder="Street" required>
              <span class="error-message" id="street_error"></span>
              
              <label for="house_number">House Number</label>
              <input id="house_number" name="house_number" placeholder="House Number" required>
              <span class="error-message" id="house_number_error"></span>
              
              <label for="postal">Postal Code</label>
              <input id="postal" name="postal" placeholder="Postal Code" inputmode="numeric" pattern="[0-9]*" required>
              <span class="error-message" id="postal_error"></span>
    
              <div class="step-buttons">
                <button type="button" class="prev">Previous</button>
                <button type="button" class="next">Next</button>
              </div>
            </div> {% endcomment %}
    
            <!-- STEP 3 – PURCHASE -->
            <div class="step" data-step="2" style="display:none;">
    
              <div class="purchase-date-method-wrapper">
                <div class="purchase-date-method-item">
                  <label for="purchase_date">Purchase Date</label>
                  <input type="date" id="purchase_date" name="purchase_date" max="" required>
                  <span class="error-message" id="purchase_date_error"></span>
                </div>
                <div class="purchase-date-method-item">
                  <label for="purchase_method">Purchase Method</label>
                  <select id="purchase_method" name="purchase_method" required>
                    <option value="">Purchase Method</option>
                    <option value="Online">Online</option>
                    <option value="store">Store</option>
                  </select>
                  <span class="error-message" id="purchase_method_error"></span>
                </div>
              </div>
    
              <label for="country_purchase">Country of Purchase</label>
              <div class="country-search-wrapper country-purchase-wrapper">
                <input type="text" id="country_purchase" name="country_purchase" placeholder="Search country..." required>
                <input type="hidden" id="country_purchase_value" name="country_purchase_value">
                <button type="button" class="country-toggle country-purchase-toggle" id="country_purchase_toggle">
                  <svg class="country-arrow country-purchase-arrow" width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1L6 6L11 1" stroke="#454545" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <div class="country-dropdown country-purchase-dropdown" id="country_purchase_dropdown"></div>
              </div>
              <span class="error-message" id="country_purchase_error"></span>

              <label for="no_id_distributor">No ID Distributor</label>
              <select id="no_id_distributor" name="no_id_distributor">
                <option value="" selected hidden>No ID Distributor</option>
              </select>
              <span class="error-message" id="no_id_distributor_error"></span>
              
              <label for="store_select">Store</label>
              <input type="text" id="store_select" name="store_select" placeholder="Input store name" readonly>
              <span class="error-message" id="store_select_error"></span>

              <label for="no_card_waranty">No Card Waranty</label>
              <input type="text" id="no_card_waranty" name="no_card_waranty" placeholder="No Card Waranty" required>
              <span class="error-message" id="no_card_waranty_error"></span>
    
              <!-- drag & drop upload -->
              {% comment %} <label for="invoice">Upload Invoice</label>
              <div id="dropzone" class="dropzone">
                <p class="dropzone-text">Drag & drop invoice here or click to upload</p>
                <p class="dropzone-filename" style="display:none;"></p>
                <input type="file" id="invoice" name="invoice" accept="image/*,application/pdf" hidden>
              </div> {% endcomment %}
              
              <!-- Serial Number -->
              <div class="model-serial-wrapper">
                <div class="model-serial-item">
                  <label for="serial_number">Serial Number</label>
                  <input type="text" id="serial_number" name="serial_number" placeholder="Serial Number" autocomplete="off" required>
                  <span class="error-message" id="serial_number_error"></span>
                </div>
              </div>

              <!-- Expired Date -->
              <div class="model-serial-wrapper">
                <div class="model-serial-item">
                  <label for="expired_date">Expired Date</label>
                  <input type="date" id="expired_date" name="expired_date" max="" readonly>
                  <span class="field-info" id="expired_date_info">Satu tahun dari tanggal pembelian</span>
                  <span class="error-message" id="expired_date_error"></span>
                </div>
              </div>
    
              <div class="step-buttons">
                <button type="button" class="prev">Previous</button>
                <button type="submit" class="submit">Submit</button>
              </div>
            </div>
    
          </form>
        </div>
      </div>
  
  <!-- Popup Modal -->
  <div id="warranty-popup-overlay" class="warranty-popup-overlay" style="display: none;">
    <div class="warranty-popup-container">
      <div class="warranty-popup-content">
        <div class="warranty-popup-icon" id="warranty-popup-icon"></div>
        <h3 class="warranty-popup-title" id="warranty-popup-title"></h3>
        <p class="warranty-popup-message" id="warranty-popup-message"></p>
        <div class="warranty-popup-product" id="warranty-popup-product" style="display: none;"></div>
        <div class="warranty-popup-buttons" id="warranty-popup-buttons"></div>
      </div>
    </div>
  </div>
  
  <!-- Popup Messages (Hidden) -->
  <div id="warranty-popup-messages" style="display: none;">
    <div data-type="confirm-title">Konfirmasi</div>
    <div data-type="confirm-message">Apakah Anda yakin data yang diisi sudah benar?</div>
    <div data-type="confirm-btn-cancel">Batal</div>
    <div data-type="confirm-btn-confirm">Ya, Saya Yakin</div>
    
    <div data-type="success-title">Product registration is complete.</div>
    <div data-type="success-message">Thank you for signing up.</div>
    <div data-type="success-btn-ok">OK</div>
    <div data-type="success-btn-collection">Check My Collection</div>
    <div data-type="success-btn-continue">Continue Registering other Products</div>
    
    <div data-type="error-title">Gagal</div>
    <div data-type="error-message">Terjadi kesalahan saat menyimpan data.</div>
    <div data-type="error-btn-ok">OK</div>
    
    <div data-type="error-form-not-found-title">Error</div>
    <div data-type="error-form-not-found-message">Form tidak ditemukan. Silakan refresh halaman.</div>
    
    <div data-type="warning-file-too-large-title">Peringatan</div>
    <div data-type="warning-file-too-large-message">File invoice terlalu besar dan tidak dapat disimpan. Data lainnya berhasil disimpan.</div>
    
