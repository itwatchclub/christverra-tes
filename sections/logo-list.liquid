{{ 'section-logo-list.css' | asset_url | stylesheet_tag }}

{%- if section.settings.title != blank -%}
  <div class="logo-list__header page-width">
    <h2 class="logo-list__title">{{ section.settings.title | escape }}</h2>
  </div>
{%- endif -%}

{%- if section.blocks.size > 0 -%}
  <div class="logo-list">
    <div
      class="logo-list__grid"
      style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: {{ section.settings.columns_mobile }}; --image-height: {{ section.settings.image_height }}px;"
    >
      {%- for block in section.blocks -%}
        <div class="logo-list__item zoom-effect" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="logo-list__link">
          {%- endif -%}

          <div class="logo-list__image-wrapper">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  alt: block.settings.image.alt,
                  class: 'logo-list__image',
                  widths: '200, 300, 400, 600',
                  sizes: '(min-width: 990px) calc(50vw - 4rem), calc(100vw - 3rem)'
              }}
            {%- else -%}
              {{ 'logo' | placeholder_svg_tag: 'logo-list__placeholder placeholder-svg' }}
            {%- endif -%}

            {%- if block.settings.overlay_text != blank -%}
              <div class="logo-list__overlay-text">
                {{ block.settings.overlay_text }}
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Logo list",
  "class": "section-logo-list",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Logo list"
    },
    {
      "type": "select",
      "id": "logo_width",
      "label": "Logo width",
      "default": "160px",
      "options": [
        { "label": "Extra Small", "value": "100px" },
        { "label": "Small", "value": "125px" },
        { "label": "Medium", "value": "160px" },
        { "label": "Large", "value": "175px" },
        { "label": "Extra Large", "value": "200px" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Number of columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Number of columns on mobile",
      "default": "2",
      "options": [
        { "label": "1 column", "value": "1" },
        { "label": "2 columns", "value": "2" }
      ]
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height",
      "min": 200,
      "max": 1000,
      "step": 8,
      "unit": "px",
      "default": 744
    },
    {
      "type": "checkbox",
      "id": "show_overlay_text",
      "label": "Show overlay text on images",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "logo_image",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional"
        },
        {
          "type": "text",
          "id": "overlay_text",
          "label": "Overlay text",
          "info": "Text shown on hover over the image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [{ "type": "logo_image" }, { "type": "logo_image" }, { "type": "logo_image" }, { "type": "logo_image" }]
    }
  ]
}
{% endschema %}
